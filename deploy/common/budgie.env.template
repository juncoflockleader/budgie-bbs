# Budgie BBS — optional operator configuration.
#
# This file is loaded by the systemd service (EnvironmentFile). EVERYTHING here
# is optional. In particular, do NOT set BUDGIE_JWT_SECRET: it is generated and
# persisted to /var/lib/budgie/jwt_secret on first start. Only set it when
# migrating an existing instance (so sessions survive the move).

# Public base URL. Used for absolute sitemap.xml / robots.txt / canonical URLs
# and for email links. Set this to your real https origin so search engines and
# shared links resolve correctly.
BUDGIE_PUBLIC_URL=https://YOUR_DOMAIN

# How often /sitemap.xml is regenerated (cache TTL). Default 6h.
#BUDGIE_SITEMAP_INTERVAL=6h

# --- Email verification (optional) -----------------------------------------
# Most providers BLOCK outbound port 25, so direct-to-MX delivery will not work;
# use a transactional SMTP relay. Enabling email also requires adding the mail
# flags to the launcher — see deployment-single-node.md. Left off, signups work
# without email verification.
#BUDGIE_MAIL_MODE=relay
#BUDGIE_MAIL_FROM=bbs@YOUR_DOMAIN

# --- Asset object store / CDN (optional) -----------------------------------
# By default the logo/banner are served from the database. Point these at an
# S3-compatible bucket to offload + CDN them once you scale.
#BUDGIE_ASSET_S3_BUCKET=
#BUDGIE_ASSET_S3_ENDPOINT=
#BUDGIE_ASSET_S3_REGION=
#BUDGIE_ASSET_S3_ACCESS_KEY=
#BUDGIE_ASSET_S3_SECRET_KEY=
#BUDGIE_ASSET_BASE_URL=https://cdn.YOUR_DOMAIN

# --- Generative AI (optional) ----------------------------------------------
# No server-side key is needed here: board moderators bring their own provider
# token in the board settings UI, and it is stored write-only. The site-wide
# master switch lives in Admin -> AI integration.
